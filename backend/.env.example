# Banco de Dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistencia_impacto

# Redis
REDIS_URL=redis://localhost:6379/0

# Autenticação JWT
CHAVE_SECRETA=sua-chave-secreta-de-256-bits-aqui
ALGORITMO=HS256
EXPIRACAO_TOKEN_ACESSO_MINUTOS=15
EXPIRACAO_REFRESH_TOKEN_DIAS=7

# CORS e Segurança
ORIGENS_CORS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000
HOSTS_PERMITIDOS=localhost,127.0.0.1

# Uploads
DIRETORIO_UPLOADS=../uploads
TAMANHO_MAXIMO_UPLOAD_MB=10
TIPOS_IMAGEM_PERMITIDOS=image/jpeg,image/png,image/webp

# E-mail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=email@gmail.com
SMTP_SENHA=senha-de-app
EMAIL_REMETENTE=noreply@assistenciaimpacto.com.br
NOME_REMETENTE=Assistência Impacto

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-api
WHATSAPP_TELEFONE=5511999999999

# APIs Externas
GOOGLE_MAPS_API_KEY=sua-chave-google-maps
VIACEP_API_URL=https://viacep.com.br/ws

# Dados da Empresa
NOME_EMPRESA=Assistência Impacto
CNPJ_EMPRESA=00.000.000/0001-00
TELEFONE_EMPRESA=(11) 99999-9999
EMAIL_EMPRESA=contato@assistenciaimpacto.com.br
ENDERECO_EMPRESA=Rua das Flores, 123 - São Paulo, SP

# Frontend
URL_FRONTEND=http://localhost:5173

# Ambiente
AMBIENTE=development
PERMITIR_REGISTRO_PUBLICO=true
