# ════════════════════════════════════════════════════
# ASSISTÊNCIA IMPACTO — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais
# ════════════════════════════════════════════════════

# ── BANCO DE DADOS ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://usuario:senha@banco:5432/assistencia_impacto
POSTGRES_DB=assistencia_impacto
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha_segura_aqui

# ── REDIS ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / SEGURANÇA ──────────────────────────────────
CHAVE_SECRETA=troque-por-uma-chave-aleatoria-de-256-bits-aqui
ALGORITMO=HS256
EXPIRACAO_TOKEN_ACESSO_MINUTOS=15
EXPIRACAO_REFRESH_TOKEN_DIAS=7

# ── CORS / HOSTS ─────────────────────────────────────
ORIGENS_CORS=http://localhost:5173,http://localhost:3000,http://localhost
HOSTS_PERMITIDOS=localhost,127.0.0.1

# ── FRONTEND (OBRIGATÓRIO: usar /api como caminho relativo) ──
VITE_API_URL=/api

# ── UPLOADS ──────────────────────────────────────────
DIRETORIO_UPLOADS=/uploads
TAMANHO_MAXIMO_UPLOAD_MB=10
TIPOS_IMAGEM_PERMITIDOS=image/jpeg,image/png,image/webp

# ── E-MAIL SMTP ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu-email@gmail.com
SMTP_SENHA=sua-senha-de-app-gmail
EMAIL_REMETENTE=noreply@assistenciaimpacto.com.br
NOME_REMETENTE=Assistência Impacto

# ── WHATSAPP (Evolution API) ──────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-evolution-api
WHATSAPP_TELEFONE=5511999999999

# ── APIs EXTERNAS ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=sua-chave-google-maps
VIACEP_API_URL=https://viacep.com.br/ws

# ── DADOS DA EMPRESA ──────────────────────────────────
NOME_EMPRESA=Assistência Impacto
CNPJ_EMPRESA=00.000.000/0001-00
TELEFONE_EMPRESA=(11) 99999-9999
EMAIL_EMPRESA=contato@assistenciaimpacto.com.br
ENDERECO_EMPRESA=Rua das Flores, 123 - São Paulo, SP

# ── URLs ──────────────────────────────────────────────
URL_FRONTEND=http://localhost
